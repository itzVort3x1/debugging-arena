// Debugging Arena - Prisma schema
// PostgreSQL, hosted on Supabase. DATABASE_URL is the pooled (pgBouncer)
// connection used at runtime; DIRECT_URL is the direct connection Prisma
// uses for migrations. See .env.example for both.
//
// `fileState` stays a plain String: Postgres maps String -> unlimited `text`,
// and the app JSON-encodes/decodes it by hand, so no `Json`/`@db.Text` needed.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String?
  image        String?
  passwordHash String?
  createdAt    DateTime @default(now())

  sessions     DebugSession[]
  accounts     Account[]
  authSessions Session[]
  hintRequests HintRequest[]
  challengeProgress UserChallengeProgress[]
}

// ----- NextAuth standard tables -----

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ----- Domain tables -----

model DebugSession {
  id            String        @id @default(cuid())
  userId        String
  challengeSlug String
  // Language variant this session solves the challenge in (a Runtime value).
  // A challenge is one session per (userId, challengeSlug, language), so the
  // same challenge can be solved independently in each language it offers.
  language      String        @default("node")
  status        String        @default("IN_PROGRESS") // SessionStatus enum (string for SQLite)
  startedAt     DateTime      @default(now())
  completedAt   DateTime?
  hintsUsed     Int           @default(0)
  attemptsCount Int           @default(0)
  timeTaken     Int? // seconds
  score         Int?
  // DEPRECATED: solution reveal is now shared per (user, challenge) via
  // UserChallengeProgress. Retained as a write-only shim for backward compat;
  // reads source from UserChallengeProgress. Dropped in a later cleanup PR.
  solutionRevealed Boolean    @default(false)
  fileState     String        @default("{}") // JSON-encoded Record<filename, content>

  // Denormalized summary of the most recent test run. TestRun keeps full
  // history (Phase 7); these fields exist for O(1) badge reads.
  lastRunPassed Int?
  lastRunFailed Int?
  lastRunTotal  Int?
  lastRunAt     DateTime?

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  testRuns     TestRun[]
  hintRequests HintRequest[]
  postmortem   Postmortem?

  @@index([userId, challengeSlug, language])
}

// SessionStatus values: IN_PROGRESS | SUBMITTED | COMPLETED | ABANDONED

model TestRun {
  id        String   @id @default(cuid())
  sessionId String
  runAt     DateTime @default(now())
  status    String // RunStatus: RUNNING | PASSED | FAILED | TIMEOUT | ERROR
  output    String
  passCount Int      @default(0)
  failCount Int      @default(0)
  duration  Int?

  session DebugSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
}

model HintRequest {
  id          String   @id @default(cuid())
  // Hint reveals are SHARED per (user, challenge): viewing a hint in one
  // language shows it viewed in every language and its penalty applies to
  // every language's score. Keyed on (userId, challengeSlug, level).
  userId        String
  challengeSlug String
  // The session the reveal was made from, kept for audit only. Nullable and
  // SET NULL on delete so the shared reveal survives its originating session.
  sessionId   String?
  level       Int
  requestedAt DateTime @default(now())

  user    User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  session DebugSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)

  // A given hint level can only be revealed once per user+challenge, shared
  // across languages and sessions.
  @@unique([userId, challengeSlug, level])
}

// Shared per-(user, challenge) progress that is independent of language and
// of any single session. Currently tracks the solution reveal (forfeits the
// score in every language), matching the shared model for hint reveals.
model UserChallengeProgress {
  id               String   @id @default(cuid())
  userId           String
  challengeSlug    String
  // True once the user reveals the full worked solution for this challenge in
  // any language. Idempotent, never retroactive (scores are stamped at submit).
  solutionRevealed Boolean  @default(false)
  updatedAt        DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, challengeSlug])
}

model Postmortem {
  id          String   @id @default(cuid())
  sessionId   String   @unique
  content     String
  generatedAt DateTime @default(now())

  session DebugSession @relation(fields: [sessionId], references: [id])
}
