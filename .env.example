# ---- Database (Supabase Postgres) ----
# Both strings come from Supabase -> Project Settings -> Database -> Connection string.
#
# DATABASE_URL: the POOLED connection (Transaction mode, port 6543). Used by the
# app at runtime. Keep the ?pgbouncer=true flag.
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true"
# DIRECT_URL: the DIRECT connection (Session mode, port 5432). Used only for
# `prisma migrate` / `prisma db push`, which can't run through the pooler.
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# ---- Avatar uploads (Supabase Storage) ----
# Unset = POST /api/profile/avatar answers 503 and the rest of the app is
# unaffected; users keep their initials.
#
# Create a PUBLIC bucket (Supabase -> Storage -> New bucket -> Public). Public
# is what lets `User.image` hold a plain URL an <img> can render; a private
# bucket would need a signed, expiring URL minted per render.
#
# SUPABASE_URL: Project Settings -> API -> Project URL.
# SUPABASE_SERVICE_ROLE_KEY: Project Settings -> API -> service_role key. This
# key bypasses row-level security - server-side only, never expose it to the
# browser or prefix it with NEXT_PUBLIC_.
SUPABASE_URL="https://<project-ref>.supabase.co"
SUPABASE_SERVICE_ROLE_KEY=""
# Bucket name. Default: avatars.
# SUPABASE_AVATAR_BUCKET="avatars"

# ---- NextAuth ----
# Dev URL. In production set this to your public origin, e.g.
#   NEXTAUTH_URL="https://arena.example.com"
NEXTAUTH_URL="http://localhost:3000"
# Required in every environment. Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=""

# ---- Anthropic ----
# Phase 7 (AI postmortem). Not required to run the app today; leave blank for now.
ANTHROPIC_API_KEY=""

# ---- Challenge runner ----
# How challenge test suites execute:
#   docker (default) - run each suite in an isolated arena-node container
#                      (no network, dropped caps, resource caps, host env NOT
#                      inherited). Requires the Docker engine running and the
#                      image built once: `npm run docker:build:node`.
#   host             - run in-process on the host. NO isolation; inherits this
#                      machine's environment. Dev/CI escape hatch only - never
#                      use in a deployed environment.
# Leave unset to default to docker.
ARENA_RUNNER="docker"

# Concurrency limits for challenge runs (admission control). Each run consumes a
# container/process, so these cap how many execute at once and how many may
# queue behind them before new runs are rejected as "busy". Per-process.
#   ARENA_MAX_CONCURRENT_RUNS - runs executing at once. Default: CPU count.
#   ARENA_MAX_QUEUED_RUNS     - runs allowed to wait for a slot. Default: 50.
# Tune down on a small host, up on a big one. Leave unset for the defaults.
# ARENA_MAX_CONCURRENT_RUNS="4"
# ARENA_MAX_QUEUED_RUNS="50"

# Challenges are read from the `Challenge` table (via DATABASE_URL) and authored
# in the admin UI, so adding one needs no redeploy and there is nothing to
# configure here. To check that the store is reachable and see what it holds,
# hit GET /api/admin/challenges/source as an admin.
#
# Back the table up with:
#   npx tsx --env-file=.env scripts/export-challenges-from-db.ts
# and restore a tree with:
#   npx tsx --env-file=.env scripts/import-challenges-to-db.ts <dir>

# Challenge cache (registry). The meta index + loaded challenges are cached in
# memory with stale-while-revalidate + stale-if-error. This is the TTL in ms
# before a background refresh; 0 disables caching (always refetch - handy for
# local authoring so challenge edits show up immediately). Default: 300000 (5m).
# ARENA_CHALLENGE_CACHE_TTL_MS="300000"

# Shared secret for POST /api/admin/challenges/revalidate, which clears this
# instance's challenge cache after seeding new content (send as
# `Authorization: Bearer <secret>`). Unset = endpoint disabled (404).
# Per-instance in a multi-instance deploy.
# ARENA_REVALIDATE_SECRET="<random secret>"
